{
  "manifest_version": 3,
  "name": "ThunderNotes",
  "version": "0.47.0",
  "description": "Highlight text in emails and attach Markdown notes.",
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "64": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "thundernotes@webterminate.com",
      "strict_min_version": "153.0"
    }
  },
  "background": {
    "scripts": [
      "dist/background.js"
    ]
  },
  "action": {
    "default_title": "ThunderNotes Tasks",
    "default_label": "ThunderNotes Tasks",
    "default_icon": "icons/tasks.svg"
  },
  "message_display_action": {
    "default_title": "ThunderNotes",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup.html",
    "default_label": ""
  },
  "permissions": [
    "messagesRead",
    "accountsRead",
    "messagesUpdate",
    "messagesTags",
    "messagesTagsList",
    "scripting",
    "menus",
    "storage",
    "clipboardRead",
    "clipboardWrite",
    "accountsFolders",
    "messagesImport",
    "messagesDelete",
    "alarms"
  ],
  "options_ui": {
    "page": "options.html"
  },
  "experiment_apis": {
    "thundernotes": {
      "schema": "experiments/thundernotes/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "thundernotes"
          ]
        ],
        "script": "experiments/thundernotes/implementation.js",
        "events": [
          "startup"
        ]
      }
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dist/live-editor.js",
        "icons/icon.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
